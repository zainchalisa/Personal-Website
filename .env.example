# Remote portfolio assets (Cloudflare Pages Direct Upload)
VITE_ASSET_BASE_URL=https://your-assets-host.example

# Bump after re-uploading files (e.g. 2, 2025-05-25) so browsers skip stale cache
VITE_ASSET_CACHE_VERSION=1

# Trip Dog (server-only — do NOT prefix with VITE_)
# Vercel: TRIPDOG_UNLOCK_PASSWORD. Cloudflare / local dev: either name works.
TRIPDOG_UNLOCK_PASSWORD=your-secret-password
# Minified JSON from tripdog.project.example.json (copy to tripdog.project.json, edit, then one-line into .env)
TRIPDOG_PROJECT_JSON={"slug":"super-secret-project","title":"✈️🐶","year":2026,"projectType":"Mobile App","status":"built","tags":["react native expo","typescript","fastapi","postgresql","google gemini"],"shortDescription":"…","coverImageUrl":null,"documentUrl":null,"documentLabel":null,"githubUrl":null,"liveSiteUrl":null}
