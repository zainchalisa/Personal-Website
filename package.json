{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "knip": "npm run knip --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "generate:photography-manifest": "node scripts/generate-photography-manifest.mjs",
    "generate:photography-variants": "node scripts/generate-photography-variants.mjs",
    "generate:photography": "npm run generate:photography-manifest && npm run generate:photography-variants",
    "check:push": "bash frontend/scripts/check-safe-push.sh",
    "prepush": "npm run check:push && npm run build"
  }
}
